# Configure a distinct development admin token and DB password.
# No API keys needed — authentication is handled via OAuth.
# Three providers are supported:
#   gemini-cli   — reuses ~/.gemini/oauth_creds.json (run `gemini` once to authenticate)
#   antigravity  — uses its own OAuth flow (~/.antigravity_tokens.json)
#   codex        — uses the official Codex SDK and ChatGPT sign-in (codex login)

# LLM provider
LLM_PROVIDER=codex

# Optional Google providers: configure the OAuth client that issued the refresh
# token for the selected provider. These settings are unused with Codex.
GEMINI_CLI_CLIENT_ID=
GEMINI_CLI_CLIENT_SECRET=
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=

# Optional: set refresh tokens below for headless / CI environments.
GEMINI_CLI_REFRESH_TOKEN=
ANTIGRAVITY_REFRESH_TOKEN=
CODEX_MODEL=gpt-6.2-sol

# Optional: Alpha Vantage API key for financial data (if using alpha_vantage vendor)
ALPHA_VANTAGE_API_KEY=

# AUTH TOKEN
TRADINGAGENTS_ADMIN_TOKEN=

# Dev Postgres (docker-compose.dev.yml — port 5433)
POSTGRES_USER=trading
POSTGRES_PASSWORD=replace-with-a-development-password
POSTGRES_DB=tradingagents_dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Data cache window
TRADINGAGENTS_STOCK_DOWNLOAD_DAYS=
TRADINGAGENTS_STOCK_DOWNLOAD_BUFFER_DAYS=
TRADINGAGENTS_STOCK_CACHE_STALE_DAYS=

# CORS (Dev FE runs on 5174)
TRADINGAGENTS_CORS_ORIGINS=

# Scheduler
TRADINGAGENTS_SCHEDULER_ENABLED=

# Logging
TRADINGAGENTS_LOG_LEVEL=