# No API keys needed — authentication is handled via OAuth.
# Three providers are supported:
#   gemini-cli   — reuses ~/.gemini/oauth_creds.json (run `gemini` once to authenticate)
#   antigravity  — uses its own OAuth flow (~/.antigravity_tokens.json)
#   codex        — uses OAuth PKCE (~/.oauth_codex/auth.json, first run opens browser)

# LLM provider
LLM_PROVIDER=codex

# Optional: set refresh tokens below for headless / CI environments.
GEMINI_CLI_REFRESH_TOKEN=
ANTIGRAVITY_REFRESH_TOKEN=
CODEX_REFRESH_TOKEN=

# Optional: Alpha Vantage API key for financial data (if using alpha_vantage vendor)
ALPHA_VANTAGE_API_KEY=

# AUTH TOKEN
TRADINGAGENTS_ADMIN_TOKEN=test

# Dev Postgres (docker-compose.dev.yml — port 5433)
POSTGRES_USER=trading
POSTGRES_PASSWORD=tradingpass
POSTGRES_DB=tradingagents_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Data cache window
TRADINGAGENTS_STOCK_DOWNLOAD_DAYS=330
TRADINGAGENTS_STOCK_DOWNLOAD_BUFFER_DAYS=300
TRADINGAGENTS_STOCK_CACHE_STALE_DAYS=3

# CORS (Dev FE runs on 5174)
TRADINGAGENTS_CORS_ORIGINS=http://localhost:5174

# Scheduler
TRADINGAGENTS_SCHEDULER_ENABLED=true

# Logging
TRADINGAGENTS_LOG_LEVEL=INFO
