# No API keys needed — authentication is handled via Google OAuth.
# Two providers are supported:
#   gemini-cli   — reuses ~/.gemini/oauth_creds.json (run `gemini` once to authenticate)
#   antigravity  — uses its own OAuth flow (~/.antigravity_tokens.json)
#
# LLM provider (default: gemini-cli). Set to skip CLI wizard selection.
# LLM_PROVIDER=gemini-cli
#
# Optional: set refresh tokens below for headless / CI environments.
# GEMINI_CLI_REFRESH_TOKEN=
# ANTIGRAVITY_REFRESH_TOKEN=
#
# Optional: Alpha Vantage API key for financial data (if using alpha_vantage vendor)
# ALPHA_VANTAGE_API_KEY=
#
# AUTH TOKEN
# TRADINGAGENTS_ADMIN_TOKEN=

# Supabase Postgres
# SUPABASE_DB_URL=
# SUPABASE_DIRECT_URL=

# Local Postgres (for docker-compose.local.yml)
# POSTGRES_USER=trading
# POSTGRES_PASSWORD=tradingpass
# POSTGRES_DB=tradingagents
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Data cache window
# TRADINGAGENTS_STOCK_DOWNLOAD_DAYS=330
# TRADINGAGENTS_STOCK_DOWNLOAD_BUFFER_DAYS=300
# TRADINGAGENTS_STOCK_CACHE_STALE_DAYS=3

# CORS (comma-separated origins, empty means *)
# TRADINGAGENTS_CORS_ORIGINS=http://localhost:5173

# Scheduler
# TRADINGAGENTS_SCHEDULER_ENABLED=true
#
# Logging
# TRADINGAGENTS_LOG_LEVEL=INFO
#
# Supabase
#SUPABASE_URL=
#SUPABASE_ANON_KEY=
#SUPABASE_SERVICE_ROLE_KEY=
#SUPABASE_DB_URL=


#POSTGRES_USER=
#POSTGRES_PASSWORD=
#POSTGRES_DB=
#POSTGRES_HOST=
#POSTGRES_PORT=
#
#POSTGRES_URL=
#POSTGRES_DIRECT_URL=
