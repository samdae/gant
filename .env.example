# No API keys needed — authentication is handled via Google OAuth.
# Two providers are supported:
#   gemini-cli   — reuses ~/.gemini/oauth_creds.json (run `gemini` once to authenticate)
#   antigravity  — uses its own OAuth flow (~/.antigravity_tokens.json)
#
# Optional: set refresh tokens below for headless / CI environments.
# GEMINI_CLI_REFRESH_TOKEN=
# ANTIGRAVITY_REFRESH_TOKEN=
#
# Optional: Alpha Vantage API key for financial data (if using alpha_vantage vendor)
# ALPHA_VANTAGE_API_KEY=
